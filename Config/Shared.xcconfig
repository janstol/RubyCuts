// Shared build configuration, committed to the repo. Pulls in a
// contributor's local, git-ignored settings (signing team, etc.) if present.
// The `?` makes the include optional, so a missing Local.xcconfig is not an
// error; see Local.xcconfig.sample for what goes in it.
#include? "Local.xcconfig"

// Apple Silicon only, permanently. There's no plan to ever build an x86_64 slice. Without this, Release/Archive builds (which don't have ONLY_ACTIVE_ARCH) would try to link x86_64 against an arm64-only libruby-static.a and fail.
ARCHS = arm64

// Embedded CRuby. Built by scripts/build-cruby.rb into Vendor/CRuby/, which is git-ignored; see docs/embedding-cruby.md. The app target's Run Script build phase fails fast with a pointer to that script if this is missing.
//
// scripts/build-cruby.rb installs one complete header tree and one static lib per SDK, under Vendor/CRuby/{include,lib}/<platform>/, where <platform> is exactly Xcode's PLATFORM_NAME (macosx, iphoneos, iphonesimulator), so both paths below key off $(PLATFORM_NAME) instead of enumerating SDKs.
CRUBY_DIR = $(SRCROOT)/Vendor/CRuby
// SYSTEM_ rather than plain HEADER_SEARCH_PATHS: -isystem marks CRuby's headers as third-party, so clang stops reporting their doc-comment and prototype warnings in our build. Warnings in our own rubycuts_shim.c still show.
SYSTEM_HEADER_SEARCH_PATHS = $(inherited) $(CRUBY_DIR)/include/$(PLATFORM_NAME)
SWIFT_OBJC_BRIDGING_HEADER = $(SRCROOT)/RubyCuts/RubyCuts-Bridging-Header.h

// -force_load pulls in the whole static archive: its symbols are otherwise reached only through rubycuts_shim.c, so the linker would drop them as unused. -lz is needed by the statically linked zlib ext.
OTHER_LDFLAGS = $(inherited) -lz -Wl,-force_load,$(CRUBY_DIR)/lib/$(PLATFORM_NAME)/libruby-static.a
