// Shared build configuration, committed to the repo. Pulls in a
// contributor's local, git-ignored settings (signing team, etc.) if present.
// The `?` makes the include optional, so a missing Local.xcconfig is not an
// error — see Local.xcconfig.sample for what goes in it.
#include? "Local.xcconfig"

// Apple Silicon only, permanently -- there's no plan to ever build an x86_64 slice. Without this, Release/Archive builds (which don't have ONLY_ACTIVE_ARCH) would try to link x86_64 against an arm64-only libruby-static.a and fail.
ARCHS = arm64

// Embedded CRuby. Built by scripts/build-cruby.rb into Vendor/CRuby/, which is git-ignored -- see docs/embedding-cruby.md. The app target's Run Script build phase fails fast with a pointer to that script if this is missing.
CRUBY_DIR = $(SRCROOT)/Vendor/CRuby
HEADER_SEARCH_PATHS = $(inherited) $(CRUBY_DIR)/include
SWIFT_OBJC_BRIDGING_HEADER = $(SRCROOT)/RubyCuts/RubyCuts-Bridging-Header.h

// SEAM: Vendor/CRuby/include/ruby/config.h is a straight copy of the one arm64/macOS config.h today, since slice 1 builds a single target. Once slice 2 adds iphoneos/iphonesimulator, a single shared header path can't hold one arch's config.h anymore -- it'll need to become a small dispatching header (`#if defined(__arm64__) && defined(TARGET_OS_IOS) ... #include "config-ios-arm64.h" ... #elif ... #include "config-macos-arm64.h" ...`) that picks the right one per build. See scripts/build-cruby.rb's install_artifacts! for where the copy happens today.

// -force_load pulls in the whole static archive: its symbols are otherwise reached only through rubycuts_shim.c, so the linker would drop them as unused. -lz is needed by the statically linked zlib ext. Only macosx is wired up in slice 1 -- iphoneos/iphonesimulator get their own OTHER_LDFLAGS[sdk=...] rows, and their own Vendor/CRuby/lib/<sdk>/ static lib, once slice 2 adds those targets to scripts/build-cruby.rb.
OTHER_LDFLAGS[sdk=macosx*] = $(inherited) -lz -Wl,-force_load,$(CRUBY_DIR)/lib/macosx/libruby-static.a
